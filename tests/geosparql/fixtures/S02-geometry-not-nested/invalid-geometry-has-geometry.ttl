#
# pgRDF GeoSPARQL fixture. Original work, authored for pgRDF from the
# GeoSPARQL 1.1 rule definitions catalogued in ../../RULES.md. No
# third-party fixture text is reproduced.
#
# Rule:   S02-geometry-not-nested
# Expect: INVALID
# Why:    ex:g-harbour is the object of hasGeometry and also its subject

@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix ex:   <http://example.org/pgrdf/> .

ex:f-harbour
    geo:hasGeometry ex:g-harbour ;
.

ex:g-harbour
    geo:asWKT "POINT (10.5 52.3)"^^geo:wktLiteral ;
    geo:hasGeometry [ geo:asWKT "POINT (10.6 52.4)"^^geo:wktLiteral ] ;
.
