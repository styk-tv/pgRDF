#
# Rule:   S04-aswkt-datatype-match
# Expect: INVALID
# Why:    geo:asWKT literal has no datatype

@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix ex:   <http://example.org/pgrdf/> .

ex:f-beacon
    geo:hasGeometry [
        geo:asWKT "POINT (10.5 52.3)" ;
    ] ;
.
