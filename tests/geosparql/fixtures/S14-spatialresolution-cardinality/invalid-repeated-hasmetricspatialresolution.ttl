#
# Rule:   S14-spatialresolution-cardinality
# Expect: INVALID
# Why:    two geo:hasMetricSpatialResolution values

@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix ex:   <http://example.org/pgrdf/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:f-beacon
    geo:hasGeometry [
        geo:hasMetricSpatialResolution "12.5"^^xsd:double , "30.0"^^xsd:double ;
    ] ;
.
