#
# Rule:   S24-spatialobjectcollection-members
# Expect: INVALID
# Why:    a member of a type outside the GeoSPARQL hierarchy

@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix ex:   <http://example.org/pgrdf/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:coll-north
    a geo:SpatialObjectCollection ;
    rdfs:member ex:m-1 , ex:m-2 ;
.

ex:m-1 a geo:Feature .
ex:m-2 a ex:Warehouse .
